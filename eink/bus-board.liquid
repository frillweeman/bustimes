{%- comment -%}
  Bus board for a 960x672 1-bit e-paper display (LaraPaper recipe, "full" layout).
  Polls http://<host>:3000/api/arrivals. Needs the device to use a 960x672
  Device Model in LaraPaper (otherwise the framework clips the page to 800x480).
  No framework classes; everything is sized in px. Black and white only:
  solid fills and heavy weights, no grey.
{%- endcomment -%}
{% assign places = "Boulder,Denver" | split: "," %}
<div style="position:relative;width:960px;height:672px;overflow:hidden;background:#fff;color:#000;font-family:Inter,Arial,Helvetica,sans-serif;font-weight:700;box-sizing:border-box">
  <div style="display:flex;justify-content:space-between;align-items:baseline;height:64px;padding:12px 24px 0;border-bottom:6px solid #000;box-sizing:border-box">
    <span style="font-size:40px;font-weight:900;letter-spacing:1px">BUS BOARD</span>
    <span style="font-size:30px;font-weight:800">{{ "now" | date: "%-I:%M %p" }}</span>
  </div>
  <div style="display:flex;height:608px">
    {% for name in places %}
      {% assign trips = data.destinations[name] %}
      <div style="flex:1;width:480px;box-sizing:border-box;{% unless forloop.last %}border-right:6px solid #000;{% endunless %}">
        <div style="background:#000;color:#fff;font-size:30px;font-weight:900;letter-spacing:2px;padding:8px 20px">{{ name | upcase }}</div>
        {% assign shown = 0 %}
        {% for trip in trips %}
          {% assign s = trip.stops[0] %}
          {% if s.minutesAway >= 0 and shown < 4 %}
            {% assign shown = shown | plus: 1 %}
            <div style="height:134px;box-sizing:border-box;padding:10px 18px;border-bottom:3px solid #000;overflow:hidden">
              <div style="display:flex;align-items:baseline;gap:14px;line-height:1">
                <span style="font-size:44px;font-weight:900">{{ trip.routeId }}</span>
                <span style="font-size:60px;font-weight:900">{{ s.minutesAway }}</span>
                <span style="font-size:26px;font-weight:800">min</span>
              </div>
              <div style="font-size:22px;font-weight:800;line-height:1.2;margin-top:6px;white-space:nowrap">{{ s.nickname }}{% unless trip.isRealtime %} (sched){% endunless %}</div>
              <div style="font-size:22px;font-weight:800;line-height:1.2;white-space:nowrap">
                E-SKATE {% if s.leaveInMinutes.electric >= 0 %}leave {{ s.leaveInMinutes.electric }}m{% else %}<span style="text-decoration:line-through">miss</span>{% endif %}
                &nbsp;&middot;&nbsp;
                BIKE {% if s.leaveInMinutes.bike >= 0 %}leave {{ s.leaveInMinutes.bike }}m{% else %}<span style="text-decoration:line-through">miss</span>{% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
        {% if shown == 0 %}
          <div style="padding:40px 20px;font-size:32px;font-weight:800">No buses soon</div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>
